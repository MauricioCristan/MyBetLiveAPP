<!-- Hosted by SystemUI, whose theme differs from the app; explicit background preserves contrast. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="vertical" android:background="#17232E" android:paddingHorizontal="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/progress_title" style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1"
        android:ellipsize="end" android:textColor="#E8F0F4" android:textSize="12sp" />
    <TextView android:id="@+id/progress_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" android:textColor="#40C983" />
    </LinearLayout>
    <ImageView android:id="@+id/progress_track" android:layout_width="match_parent"
        android:layout_height="28dp" android:scaleType="fitXY" android:contentDescription="@null" />
    <TextView android:id="@+id/progress_status" android:layout_width="match_parent" android:layout_height="28dp"
        android:gravity="center_vertical" android:textColor="#9AAEBB" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
